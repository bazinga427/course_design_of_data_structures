{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "编译整个项目",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                "-I",
                "${workspaceFolder}/third_party/easyx/include",
                "-L",
                "${workspaceFolder}/third_party/easyx/lib64",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\graph.cpp",
                "-o",
                "${workspaceFolder}\\main.exe",
                "-leasyx"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "用 PATH 里的 g++ 编译。EasyX 已经放在 third_party 目录里，-I / -L / -leasyx 都已经配好（必须带 -I，否则会撞上 MinGW 自带的 EGE 图形库）。队友加了 ui.cpp / layout.cpp 之后，只要在 \"-o\" 那行之前把文件名补进去即可。"
        }
    ],
    "version": "2.0.0"
}
