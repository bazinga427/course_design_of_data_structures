{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "编译整个项目",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\graph.cpp",
                "-o",
                "${workspaceFolder}\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "用 PATH 里的 g++ 编译，不写死任何机器路径。队友加了 ui.cpp / layout.cpp 之后，在 args 里把文件名加进去，末尾再加 \"-leasyx\"。"
        }
    ],
    "version": "2.0.0"
}
