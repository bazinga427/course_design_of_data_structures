{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "编译整个项目",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++17",
                "-static",
                "-static-libgcc",
                "-static-libstdc++",
                "-I",
                "${workspaceFolder}/third_party/easyx/include",
                "-L",
                "${workspaceFolder}/third_party/easyx/lib64",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\graph.cpp",
                "${workspaceFolder}\\flow.cpp",
                "-o",
                "${workspaceFolder}\\main.exe",
                "-leasyx"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Ctrl+Shift+B 编译。以后加了 ui.cpp / flow.cpp，把文件名补在 -o 那行之前即可。"
        }
    ]
}
